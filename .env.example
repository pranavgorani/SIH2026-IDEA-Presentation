# ==============================================================================
# TRUST-ID — AI-Powered Fake Identity & Document Screening Platform
# Problem Statement: SIH26188 (Ministry of Home Affairs)
# Environment Configuration Blueprint
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
VERSION=1.0.0-sih2026
ENVIRONMENT=development

# Database Persistence
# WARNING: Never commit a DATABASE_URL containing real credentials to version control.
# Local SQLite default (used automatically if DATABASE_URL is unset): sqlite:///./backend/data/trustid.db
# PostgreSQL Container connection string template:
DATABASE_URL=postgresql://trustid_user:CHANGE_ME_LOCALLY@postgres:5432/trustid_db
POSTGRES_USER=trustid_user
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
POSTGRES_DB=trustid_db

# Cryptographic Authentication (HMAC-SHA256 JWT)
# Generate a secure 48+ byte random secret for production:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_LOCALLY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Permitted Origins (Comma-separated list of allowed origins)
# For local development: http://localhost:3000,http://127.0.0.1:3000
# For production: https://YOUR-VERCEL-DOMAIN.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage Configuration (Local Object Storage or S3-compatible Endpoint)
STORAGE_DIR=./backend/storage
STORAGE_MAX_FILE_SIZE_MB=15
STORAGE_BUCKET=trustid-forensic-quarantine
STORAGE_ENDPOINT=

# AI & Computer Vision Provider Mode
# Options:
# 1. LOCAL_CV_FALLBACK  - Deterministic OpenCV, ELA, noise grids, and heuristics (Zero external API dependencies)
# 2. GEMINI_VISION_HYBRID - Server-side Google Gemini Vision multimodal analysis + Local CV fallback
AI_PROVIDER=LOCAL_CV_FALLBACK

# Google Gemini API Key (Rotated; supply securely via environment variable only)
# IMPORTANT: The Gemini key is server-side only. It is NEVER exposed to the browser or frontend.
GEMINI_API_KEY=YOUR_NEW_ROTATED_GEMINI_KEY

# Central Registry Verification Adapter
# Options: MOCK_SIMULATED (Demo Benchmark Mode) | SANDBOX_GATEWAY (Official Consular/Passport API)
VERIFICATION_MODE=MOCK_SIMULATED

# Redis Distributed Cache & Async Job Worker (Optional)
REDIS_URL=redis://localhost:6379/0

# Next.js Frontend Environment
# In Vercel production: Leave empty or unset to use relative /api/backend routing via Vercel Services
# In local development: Optional override if pointing directly to a standalone backend instance
NEXT_PUBLIC_API_URL=
BACKEND_API_URL=http://127.0.0.1:8000
