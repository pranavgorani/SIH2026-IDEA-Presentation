# ==============================================================================
# TRUST-ID — AI-Powered Fake Identity & Document Screening Platform
# Problem Statement: SIH26188 (Ministry of Home Affairs)
# Environment Configuration Blueprint
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
VERSION=1.0.0-sih2026

# Database Persistence (PostgreSQL for Production, SQLite fallback for Local Dev)
# Local SQLite default: sqlite:///./backend/trustid.db
# PostgreSQL Container: postgresql://trustid_user:trustid_password@postgres:5432/trustid_db
DATABASE_URL=sqlite:///./backend/trustid.db

# Cryptographic Authentication (HMAC-SHA256 JWT)
# Generate a secure 32+ byte string in production: openssl rand -hex 32
JWT_SECRET=trustid_sih2026_tamper_evident_secure_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Permitted Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage Configuration (Local Object Storage or AWS/GCS S3 Endpoint)
STORAGE_DIR=./backend/storage
STORAGE_MAX_FILE_SIZE_MB=15
STORAGE_BUCKET=trustid-forensic-quarantine
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# AI & Computer Vision Provider Mode
# Options: LOCAL_CV_FALLBACK (Deterministic OpenCV/ELA) | GEMINI_VISION_HYBRID | SANDBOXED_NEURAL_NET
AI_PROVIDER=LOCAL_CV_FALLBACK
GEMINI_API_KEY=your_gemini_api_key_here

# Central Registry Verification Adapter
# Options: MOCK_SIMULATED (Demo Benchmark Mode) | SANDBOX_GATEWAY (Official Consular/Passport API)
VERIFICATION_MODE=MOCK_SIMULATED

# Redis Distributed Cache & Async Job Worker (Optional)
REDIS_URL=redis://localhost:6379/0

# Next.js Frontend Environment
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
