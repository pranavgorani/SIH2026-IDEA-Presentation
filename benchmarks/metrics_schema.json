{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nyaya-Tula AI Evaluation Metrics Schema",
  "type": "object",
  "required": [
    "evaluation_timestamp",
    "dataset_name",
    "environment",
    "ocr_metrics",
    "classification_metrics",
    "tampering_metrics",
    "risk_engine_metrics",
    "latency_metrics"
  ],
  "properties": {
    "evaluation_timestamp": { "type": "string" },
    "dataset_name": { "type": "string" },
    "sample_size": { "type": "integer" },
    "environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "python_version": { "type": "string" },
        "hardware": { "type": "string" },
        "ocr_engine": { "type": "string" }
      }
    },
    "ocr_metrics": {
      "type": "object",
      "properties": {
        "character_error_rate_cer": { "type": "number" },
        "word_error_rate_wer": { "type": "number" },
        "field_exact_match_accuracy": { "type": "number" },
        "extraction_completeness_rate": { "type": "number" }
      }
    },
    "classification_metrics": {
      "type": "object",
      "properties": {
        "accuracy": { "type": "number" },
        "precision": { "type": "number" },
        "recall": { "type": "number" },
        "macro_f1": { "type": "number" },
        "per_type_metrics": { "type": "object" },
        "confusion_matrix": { "type": "object" }
      }
    },
    "tampering_metrics": {
      "type": "object",
      "properties": {
        "precision": { "type": "number" },
        "recall": { "type": "number" },
        "f1_score": { "type": "number" },
        "false_positive_rate": { "type": "number" },
        "false_negative_rate": { "type": "number" }
      }
    },
    "risk_engine_metrics": {
      "type": "object",
      "properties": {
        "false_positive_rate_genuine": { "type": "number" },
        "false_negative_rate_tampered": { "type": "number" },
        "review_escalation_rate": { "type": "number" }
      }
    },
    "latency_metrics": {
      "type": "object",
      "properties": {
        "preprocessing_ms": { "type": "number" },
        "ocr_extraction_ms": { "type": "number" },
        "validation_ms": { "type": "number" },
        "tampering_analysis_ms": { "type": "number" },
        "total_pipeline_ms": { "type": "number" }
      }
    }
  }
}
